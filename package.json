{
  "name": "jixone-desktop",
  "productName": "JixOne",
  "version": "1.0.0",
  "description": "JixOne music player for Windows, macOS and Linux",
  "main": "dist/main.js",
  "author": "JixOne",
  "license": "GPL-3.0",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "bgutils-js": "^4.0.3",
    "jsdom": "^26.1.0",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vazirmatn": "^33.0.3"
  },
  "build": {
    "appId": "com.jixone.desktop",
    "productName": "JixOne",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "JixOne-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "JixOne-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "JixOne-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "artifactName": "JixOne-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "artifactName": "JixOne-${version}-linux.${ext}"
    }
  }
}
